{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@0x3639/intervals-icu",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs-dist/latest",
  "readme": "README.md",
  "projectDocuments": ["docs/guides/getting-started.md", "docs/guides/authentication.md", "docs/guides/errors-and-retries.md", "docs/guides/dates-pagination-and-arrays.md", "docs/guides/files.md", "docs/guides/services.md"],
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "requiredToBeDocumented": ["Class", "Interface", "Method", "TypeAlias", "Enum", "Function"],
  "validation": { "notExported": true, "invalidLink": true, "notDocumented": true },
  "treatWarningsAsErrors": true,
  "navigationLinks": { "GitHub": "https://github.com/0x3639/node-intervals-icu" },
  "categorizeByGroup": true,
  "sort": ["kind", "alphabetical"],
  "sortEntryPoints": false,
  "githubPages": true,
  "cleanOutputDir": true
}
