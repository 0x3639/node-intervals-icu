{
  "name": "@0x3639/intervals-icu",
  "version": "3.0.0-beta.1",
  "description": "Comprehensive TypeScript client library for the Intervals.icu API — 100+ endpoints, full type safety, OAuth & API key auth",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify",
    "docs": "typedoc && node scripts/docs-root-redirect.mjs docs-dist",
    "docs:check": "npm run docs && node scripts/check-docs-links.mjs docs-dist",
    "lint": "eslint src scripts --ext .ts,.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:examples && npm run typecheck:tests",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "coverage:api": "node scripts/coverage.mjs",
    "spec:drift": "node scripts/check-spec-drift.mjs",
    "audit:probe": "node scripts/audit-probe.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "intervals.icu",
    "intervals",
    "training",
    "cycling",
    "running",
    "swimming",
    "triathlon",
    "api",
    "client",
    "typescript",
    "strava",
    "fitness",
    "workout",
    "wellness"
  ],
  "author": "0x3639 (https://github.com/0x3639)",
  "contributors": [
    "Fernando Paladini <fnpaladini+nodeintervals@gmail.com> (https://github.com/paladini)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x3639/node-intervals-icu.git"
  },
  "bugs": {
    "url": "https://github.com/0x3639/node-intervals-icu/issues"
  },
  "homepage": "https://github.com/0x3639/node-intervals-icu#readme",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "harness-score": "^1.3.2",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
